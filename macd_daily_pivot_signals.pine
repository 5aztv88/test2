//@version=6
indicator("MACD Divergence + Classic Daily Pivot Signals", shorttitle="MACD Pivot Signals", overlay=true, max_labels_count=500)

fastLength = input.int(12, "Fast length", minval=1, group="MACD")
slowLength = input.int(26, "Slow length", minval=1, group="MACD")
signalLength = input.int(9, "Signal length", minval=1, group="MACD")
source = input.source(close, "Source", group="MACD")
divergenceType = input.string("Hidden (reverse)", "Divergence type", options=["Hidden (reverse)", "Regular (reversal)", "Both"], group="Divergence")
waveLookback = input.int(5, "Earlier same-side waves to compare", minval=1, maxval=50, group="Divergence")
minWaveBars = input.int(3, "Minimum bars per wave", minval=1, maxval=100, group="Divergence")
maxSeparation = input.int(300, "Maximum bars between price extremes", minval=2, maxval=10000, group="Divergence")
touchTicks = input.int(5, "Level touch tolerance (ticks)", minval=0, group="Daily pivots")

if timeframe.in_seconds() > timeframe.in_seconds("1D")
    runtime.error("Use a daily or intraday chart for daily pivot signals.")

[macdLine, signalLine, histogram] = ta.macd(source, fastLength, slowLength, signalLength)

// Previous completed exchange daily candle: no developing daily values.
[previousHigh, previousLow, previousClose] = request.security(syminfo.tickerid, "1D", [high[1], low[1], close[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
pivot = (previousHigh + previousLow + previousClose) / 3.0
dailyRange = previousHigh - previousLow
s2 = pivot - dailyRange
s3 = pivot - 2.0 * dailyRange
r2 = pivot + dailyRange
r3 = pivot + 2.0 * dailyRange

// A touch means the candle's range intersects the level plus/minus tolerance.
tolerance = touchTicks * syminfo.mintick
touches(float level) =>
    not na(level) and low <= level + tolerance and high >= level - tolerance

supportTouch = touches(s2) or touches(s3)
resistanceTouch = touches(r2) or touches(r3)
useHidden = divergenceType != "Regular (reversal)"
useRegular = divergenceType != "Hidden (reverse)"

// Each record pairs the histogram extreme and price extreme of an entire wave.
// They can occur on different candles within that wave.
type Wave
    float price
    float hist
    int priceBar

var array<Wave> negativeWaves = array.new<Wave>()
var array<Wave> positiveWaves = array.new<Wave>()

hasDivergence(array<Wave> history, float price, float hist, int priceBar, bool bullish) =>
    bool found = false
    if array.size(history) > 0
        for i = 0 to array.size(history) - 1
            prior = array.get(history, i)
            distance = priceBar - prior.priceBar
            if distance > 0 and distance <= maxSeparation
                hidden = bullish ? price > prior.price and hist < prior.hist : price < prior.price and hist > prior.hist
                regular = bullish ? price < prior.price and hist > prior.hist : price > prior.price and hist < prior.hist
                if (useHidden and hidden) or (useRegular and regular)
                    found := true
    found

var int waveSign = 0
var int waveBars = 0
var float wavePrice = na
var float waveHistogram = na
var int wavePriceBar = na
var bool waveTouch = false
// The first observed wave can be truncated by the chart's available history.
var bool waveHasStart = false
bool buySignal = false
bool sellSignal = false

if barstate.isconfirmed and not na(histogram) and histogram != 0
    currentSign = histogram > 0 ? 1 : -1
    if waveSign == 0
        waveSign := currentSign
        waveBars := 1
        wavePrice := currentSign < 0 ? low : high
        waveHistogram := histogram
        wavePriceBar := bar_index
        waveTouch := currentSign < 0 ? supportTouch : resistanceTouch
    else if currentSign == waveSign
        waveBars += 1
        waveHistogram := waveSign < 0 ? math.min(waveHistogram, histogram) : math.max(waveHistogram, histogram)
        priceExtreme = waveSign < 0 ? low : high
        touched = waveSign < 0 ? supportTouch : resistanceTouch
        newExtreme = waveSign < 0 ? priceExtreme < wavePrice : priceExtreme > wavePrice
        if newExtreme
            wavePrice := priceExtreme
            wavePriceBar := bar_index
            waveTouch := touched
        else if priceExtreme == wavePrice
            waveTouch := waveTouch or touched
    else
        // An opposite-sign closed candle confirms the completed wave.
        if waveHasStart and waveBars >= minWaveBars
            history = waveSign < 0 ? negativeWaves : positiveWaves
            divergence = hasDivergence(history, wavePrice, waveHistogram, wavePriceBar, waveSign < 0)
            buySignal := waveSign < 0 and waveTouch and divergence
            sellSignal := waveSign > 0 and waveTouch and divergence
            array.unshift(history, Wave.new(wavePrice, waveHistogram, wavePriceBar))
            if array.size(history) > waveLookback
                array.pop(history)
        waveSign := currentSign
        waveBars := 1
        wavePrice := currentSign < 0 ? low : high
        waveHistogram := histogram
        wavePriceBar := bar_index
        waveTouch := currentSign < 0 ? supportTouch : resistanceTouch
        waveHasStart := true

// Display on the confirmation candle, without backdating to the swing.
plotshape(buySignal, title="BUY", text="BUY", style=shape.labelup, location=location.belowbar, color=color.green, textcolor=color.white, size=size.small, force_overlay=true)
plotshape(sellSignal, title="SELL", text="SELL", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.white, size=size.small, force_overlay=true)
alertcondition(buySignal, "BUY: support + MACD divergence", "BUY: S2/S3 touch and confirmed MACD histogram wave divergence on {{ticker}} {{interval}}.")
alertcondition(sellSignal, "SELL: resistance + MACD divergence", "SELL: R2/R3 touch and confirmed MACD histogram wave divergence on {{ticker}} {{interval}}.")
